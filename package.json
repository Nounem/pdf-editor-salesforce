    "check": "node scripts/check.mjs",
    "docs:screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@lwc/compiler": "8.28.2",
    "@playwright/test": "1.64.0",
    "@salesforce/sfdx-lwc-jest": "7.9.0",
    "esbuild": "0.28.2"
  }
}
