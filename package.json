{
  "name": "love-pdf-sales",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype d'édition PDF pour Salesforce Lightning",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/model.test.mjs && sfdx-lwc-jest -- --runInBand",
